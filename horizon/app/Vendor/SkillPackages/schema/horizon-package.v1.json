{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OTNworld/generate-shortcuts-skill-Hermes-/data/schemas/horizon-package.v1.json",
  "title": "horizon-package/v1",
  "type": "object",
  "required": ["schema", "id", "name", "version", "license", "shortcuts"],
  "properties": {
    "schema": { "const": "horizon-package/v1" },
    "id": {
      "type": "string",
      "minLength": 2,
      "description": "Stable package id (kebab-case)"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "model_policy": {
      "type": "string",
      "enum": ["none", "apple-intelligence", "on-device-preferred", "cloud-allowed"]
    },
    "siri_phrases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "shortcuts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string",
            "description": "Repo-relative path to unsigned .shortcut.xml"
          },
          "role": {
            "type": "string",
            "enum": ["primary", "variant", "dependency"]
          },
          "output_name": { "type": "string" }
        }
      }
    },
    "attestation": {
      "type": "object",
      "properties": {
        "matrix_ref": { "type": "string" },
        "results_ref": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["unattested", "mac-import", "mac-run", "ios-sample"]
        }
      }
    },
    "edit": {
      "type": "object",
      "properties": {
        "skill_path": { "type": "string" },
        "deep_link": { "type": "string" }
      }
    }
  },
  "additionalProperties": true
}
