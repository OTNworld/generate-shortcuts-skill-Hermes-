      "fills a gap vs templates/examples/",
      "passes ./scripts/validate.sh grammar checks",
      "attribution recorded in THIRD_PARTY_NOTICES.md"
    ],
    "do_not_vendor": [
      "GPL / copyleft sources as code (link only)",
      "unsigned personal vault exports with PII",
      "entire peer skill trees (~10k+ lines) \u2014 keep as peer reference"
    ]
  },
