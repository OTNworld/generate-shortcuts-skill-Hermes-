{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OTNworld/generate-shortcuts-skill-Hermes-/data/schemas/appintents.v1.json",
  "title": "appintents catalog",
  "type": "object",
  "required": ["count", "identifiers"],
  "properties": {
    "description": { "type": "string" },
    "count": { "type": "integer", "minimum": 1 },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "unverified": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Subset of identifiers not yet export-verified on device; do not use in teaching appintentexecution goldens"
    }
  },
  "additionalProperties": true
}
