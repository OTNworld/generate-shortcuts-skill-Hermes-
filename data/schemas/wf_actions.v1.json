{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OTNworld/generate-shortcuts-skill-Hermes-/data/schemas/wf_actions.v1.json",
  "title": "wf_actions catalog",
  "type": "object",
  "required": ["prefix", "count", "identifiers"],
  "properties": {
    "prefix": { "type": "string", "const": "is.workflow.actions." },
    "count": { "type": "integer", "minimum": 1 },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "platform_hints": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["mac", "ios", "both", "unknown"]
      }
    }
  },
  "additionalProperties": true
}
