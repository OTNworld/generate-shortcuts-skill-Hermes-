{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OTNworld/generate-shortcuts-skill-Hermes-/data/schemas/sources.v1.json",
  "title": "sources registry v1",
  "type": "object",
  "required": ["version", "policy", "sources"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "policy": {
      "type": "object",
      "required": ["prefer", "vendor_when", "do_not_vendor"],
      "properties": {
        "prefer": { "type": "string" },
        "vendor_when": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "do_not_vendor": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "role", "license", "use", "notes"],
        "properties": {
          "id": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "minLength": 8 },
          "role": { "type": "string", "minLength": 2 },
          "license": { "type": "string", "minLength": 1 },
          "use": {
            "type": "string",
            "enum": ["link", "cite-and-adapt", "index", "index+selective-vendor", "official"]
          },
          "notes": { "type": "string" },
          "local_index": { "type": "string" },
          "vendored_examples": {
            "type": "array",
            "items": { "type": "string" }
          },
          "last_checked": { "type": "string" },
          "archived": { "type": "boolean" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
